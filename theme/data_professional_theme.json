{
  "name": "Data Professional Survey - Dark Teal",
  "dataColors": ["#00A6A6", "#F2B134", "#ED553B", "#3E7CB1", "#7FB069", "#9D6A89", "#F28F3B", "#5C6B73"],
  "background": "#0F1B26",
  "foreground": "#E8EEF2",
  "tableAccent": "#00A6A6",
  "good": "#2E9E6B",
  "neutral": "#F2B134",
  "bad": "#E4572E",
  "maximum": "#00A6A6",
  "center": "#F2B134",
  "minimum": "#ED553B",
  "null": "#5C6B73",
  "textClasses": {
    "callout":  { "fontSize": 30, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "title":    { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#E8EEF2" },
    "header":   { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#E8EEF2" },
    "label":    { "fontSize": 10, "fontFace": "Segoe UI", "color": "#B7C4CE" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#16293A" } }, "transparency": 0 }],
        "border":     [{ "show": false }],
        "title":      [{ "show": true, "fontColor": { "solid": { "color": "#E8EEF2" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }],
        "visualHeader": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0F1B26" } }, "transparency": 0 }]
      }
    }
  }
}
